# Where a built game looks for the relay.
#
# This lives in a file rather than in whoever-remembers-the-command, because
# forgetting it does not fail loudly: the build falls back to the page's own
# host on port 8787, which is right for `npm run dev` and silently wrong once
# deployed. Nothing about the page looks broken — the room just never opens.
VITE_RELAY_URL=wss://salient-relay.yi39344.workers.dev
